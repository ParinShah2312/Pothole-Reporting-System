# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pothole_db

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# Image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI service (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Phase 0: local image storage
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# AI decision thresholds (pothole confidence 0–1)
AI_ACCEPT_THRESHOLD=0.6
AI_REJECT_THRESHOLD=0.4

# Location rules (metres)
PIN_MOVE_FLAG_M=200
LOW_GPS_ACCURACY_M=100
DUPLICATE_RADIUS_M=25
REPAIR_RADIUS_M=50
